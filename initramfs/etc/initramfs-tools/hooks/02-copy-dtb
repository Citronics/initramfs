#!/bin/sh

PREREQ=""

prereqs() {
    echo "$PREREQ"
}

case "$1" in
    prereqs)
        prereqs
        exit 0
        ;;
esac

. /usr/share/initramfs-tools/hook-functions

# Source deviceinfo (same pattern as misc/source_deviceinfo)
[ -f /usr/share/carrierinfo/carrierinfo ] && . /usr/share/carrierinfo/carrierinfo
[ -f /usr/share/deviceinfo/deviceinfo ] && . /usr/share/deviceinfo/deviceinfo
[ -f /etc/deviceinfo ] && . /etc/deviceinfo

# Detect the board variant rather than trusting deviceinfo_dtb to be right (see
# /usr/share/citronics/detect-dtb.sh). This must use the same logic as
# /etc/kernel/postinst.d/zz-citronics-boot: if the two disagree, the DTB inside
# the initramfs is not the DTB the bootloader loads. Without this, an unset or
# "auto" setting reached the loop below verbatim and produced
# "[Hook] Warning: DTB not found for auto".
if [ -f /usr/share/citronics/detect-dtb.sh ]; then
    . /usr/share/citronics/detect-dtb.sh
    deviceinfo_dtb="$(citronics_detect_dtb "${version}")"
elif [ -z "$deviceinfo_dtb" ]; then
    echo "[Hook] Warning: deviceinfo_dtb not set, falling back to FP2 DTB"
    deviceinfo_dtb="qcom-msm8974pro-fairphone-fp2.dtb"
fi

echo "[Hook] Copying DTB(s): $deviceinfo_dtb"

mkdir -p "${DESTDIR}/boot"
for dtb in $deviceinfo_dtb; do
    DTB_NAME="$(basename $dtb)"
    DTB_DST="${DESTDIR}/boot/${DTB_NAME}"
    DTB_SRC=""
    if [ -e "/usr/lib/linux-image-${version}/${dtb}" ]; then
        DTB_SRC="/usr/lib/linux-image-${version}/${dtb}"
    elif [ -e "/usr/lib/linux-image-${version}/qcom/${DTB_NAME}" ]; then
        DTB_SRC="/usr/lib/linux-image-${version}/qcom/${DTB_NAME}"
    fi
    if [ -n "$DTB_SRC" ]; then
        echo "[Hook] Copying DTB from $DTB_SRC to $DTB_DST"
        cp "$DTB_SRC" "$DTB_DST"
    else
        echo "[Hook] Warning: DTB not found for ${dtb}"
    fi
done
