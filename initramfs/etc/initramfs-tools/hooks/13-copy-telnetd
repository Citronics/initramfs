#!/bin/sh

PREREQ=""

prereqs() {
    echo "$PREREQ"
}

case $1 in
    prereqs)
        prereqs
        exit 0
        ;;
esac

. /usr/share/initramfs-tools/hook-functions

# busybox-static's telnetd, for the debug_console USB shell: no telnet server
# package in the root filesystem.
echo "[Hook] Add telnetd (busybox)"
BUSYBOX=$(command -v busybox || true)
if [ -z "$BUSYBOX" ]; then
    echo "[Hook] Warning: busybox not found, skipping telnetd"
    exit 0
fi
copy_exec "$BUSYBOX" /bin/busybox
mkdir -p "${DESTDIR}/sbin"
ln -sf /bin/busybox "${DESTDIR}/sbin/telnetd"
