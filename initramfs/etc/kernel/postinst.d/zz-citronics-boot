#!/bin/sh
set -eu

KVER="$1"

deviceinfo_arch=""
deviceinfo_dtb=""

if [ -f /usr/share/deviceinfo/deviceinfo ]; then
  . /usr/share/deviceinfo/deviceinfo
fi
if [ -f /etc/deviceinfo ]; then
  . /etc/deviceinfo
fi

echo "Updating boot partition for kernel $KVER"

if [ ! -f "/boot/vmlinuz-$KVER" ]; then
  echo "WARNING: /boot/vmlinuz-$KVER not found, skipping boot partition update"
  exit 0
fi

if [ "$deviceinfo_arch" = "aarch64" ] || [ "$deviceinfo_arch" = "arm64" ]; then
  KIMG="Image.gz"
else
  KIMG="zImage"
fi

# Drop files the boot flow never reads BEFORE generating the initramfs:
# the package just unpacked System.map/config onto the tightly-sized boot
# partition and the generated initramfs needs that space.
rm -f "/boot/System.map-$KVER"
rm -f "/boot/config-$KVER"

# On an installed, bootable system (zImage/initramfs.gz present), never
# switch the kernel image without a freshly generated, validated initramfs:
# a failed `apt install` that leaves the old kernel booting is recoverable,
# a boot partition with a new kernel and a stale/truncated initramfs is a
# brick. Two hard-won rules apply here:
#  - update-initramfs can exit 0 even when the compressor ran out of space,
#    so success is only ever established by validating the artifact;
#  - /boot/initramfs.gz (the file the bootloader loads) is only replaced
#    by a file that passed validation, never before.
# At image build time /boot has no bootable state yet, so this block is
# skipped and setup-boot.sh/verify-boot.sh own the boot contract instead.
# The initramfs generated below is for the kernel being switched to; tell
# 01-rename-initrd-file it may install it.
export CITRONICS_BOOT_KERNEL="$KVER"

if [ -f "/boot/$KIMG" ] || [ -f /boot/initramfs.gz ]; then
  GENERATED=n
  PREV_STAMP=$(stat -c %Y /boot/initramfs.gz 2>/dev/null || echo 0)
  if [ ! -f "/boot/initrd.img-$KVER" ]; then
    echo "Generating initramfs for $KVER"
    update-initramfs -c -k "$KVER" || true
    GENERATED=y
  fi
  if [ -f "/boot/initrd.img-$KVER" ]; then
    if gzip -t "/boot/initrd.img-$KVER" 2>/dev/null; then
      mv "/boot/initrd.img-$KVER" /boot/initramfs.gz
      echo "Renamed initrd.img-$KVER to /boot/initramfs.gz"
    else
      rm -f "/boot/initrd.img-$KVER"
      echo "ERROR: generated initramfs for $KVER is truncated (out of space on /boot?)" >&2
      echo "ERROR: boot partition NOT switched, the previous kernel remains active" >&2
      exit 1
    fi
  elif [ "$GENERATED" = y ]; then
    # No initrd left behind: either the post-update hook validated and
    # renamed it (initramfs.gz stamp changed), or generation produced
    # nothing and initramfs.gz is stale for this kernel.
    NEW_STAMP=$(stat -c %Y /boot/initramfs.gz 2>/dev/null || echo 0)
    if [ "$NEW_STAMP" = "$PREV_STAMP" ]; then
      echo "ERROR: initramfs generation for $KVER produced nothing" >&2
      echo "ERROR: boot partition NOT switched, the previous kernel remains active" >&2
      exit 1
    fi
  fi
  if ! gzip -t /boot/initramfs.gz 2>/dev/null; then
    echo "ERROR: /boot/initramfs.gz is corrupt, boot partition NOT switched" >&2
    exit 1
  fi
fi

cp "/boot/vmlinuz-$KVER" "/boot/$KIMG"
echo "Copied vmlinuz-$KVER to /boot/$KIMG"

# The kernel in /boot/$KIMG: 01-rename-initrd-file only installs an initramfs
# built for it. With an older-numbered kernel installed after a newer one
# (6.16 -> 6.12), "update-initramfs -u" picks the highest version, and its
# initramfs must not end up next to the kernel that actually boots.
mkdir -p /var/lib/citronics-initramfs
echo "$KVER" > /var/lib/citronics-initramfs/boot-kernel

# Which device tree this board needs is detected, not remembered. The FP2
# mainboard runs both in a phone and on a battery-less, panel-less carrier
# board, and the two need different trees; leaving the choice in
# /etc/deviceinfo means a rig that resets under load, or a phone with a black
# screen, the first time somebody forgets to change it — or to change it back.
# An explicit deviceinfo_dtb still wins; "auto" asks for detection explicitly.
if [ -f /usr/share/citronics/detect-dtb.sh ]; then
  . /usr/share/citronics/detect-dtb.sh
  deviceinfo_dtb="$(citronics_detect_dtb "$KVER")"
elif [ -z "$deviceinfo_dtb" ]; then
  deviceinfo_dtb="qcom-msm8974pro-fairphone-fp2.dtb"
  echo "deviceinfo_dtb not set, falling back to $deviceinfo_dtb"
fi

# Kernel packages ship DTBs either flat in /usr/lib/linux-image-$KVER/ or
# under a qcom/ subdirectory, depending on the package version.
for DTB in $deviceinfo_dtb; do
  DTB_NAME="$(basename "$DTB")"
  DTB_SRC=""
  if [ -f "/usr/lib/linux-image-$KVER/$DTB" ]; then
    DTB_SRC="/usr/lib/linux-image-$KVER/$DTB"
  elif [ -f "/usr/lib/linux-image-$KVER/qcom/$DTB_NAME" ]; then
    DTB_SRC="/usr/lib/linux-image-$KVER/qcom/$DTB_NAME"
  fi
  if [ -n "$DTB_SRC" ]; then
    cp "$DTB_SRC" "/boot/$DTB_NAME"
    echo "Copied DTB: $DTB_SRC"
    COPIED_DTB="$DTB_NAME"
  else
    echo "WARNING: $DTB not found in /usr/lib/linux-image-$KVER, skipping"
  fi
done

# Copying the DTB is only half of it: lk2nd loads whatever extlinux.conf's
# "fdt" line names, so a correct copy behind a stale fdt line still boots the
# wrong tree — which is exactly the failure this hook is meant to make
# impossible. Only lines already pointing at a known FP2 DTB are rewritten.
if [ -n "${COPIED_DTB:-}" ] && command -v citronics_set_extlinux_fdt >/dev/null 2>&1; then
  citronics_set_extlinux_fdt "$COPIED_DTB"
fi

# /boot/vmlinuz-$KVER is kept: update-initramfs enumerates kernels via
# /boot/vmlinuz-* for future regenerations on the device.
echo "Boot partition updated for $KVER"
