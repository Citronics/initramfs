#!/bin/sh
# Record which installed kernel /boot holds, on systems set up before
# zz-citronics-boot recorded it: the kernel whose /boot/vmlinuz-* copy
# matches /boot/zImage (or Image.gz).
set -e
STATE=/var/lib/citronics-initramfs/boot-kernel
if [ "$1" = configure ] && [ ! -s "$STATE" ]; then
	for KIMG in /boot/zImage /boot/Image.gz; do
		[ -f "$KIMG" ] || continue
		for v in /boot/vmlinuz-*; do
			[ -f "$v" ] || continue
			if cmp -s "$v" "$KIMG"; then
				mkdir -p "$(dirname "$STATE")"
				echo "${v#/boot/vmlinuz-}" > "$STATE"
				break 2
			fi
		done
	done
fi

# Versions before 1.1.2.3 pulled in inetutils-telnetd, a telnet server on
# every interface. Nothing needs it any more: when apt installed it only as
# that dependency, stop it now; "apt autoremove" removes it.
if [ "$1" = configure ] && command -v apt-mark >/dev/null &&
   apt-mark showauto inetutils-inetd 2>/dev/null | grep -qx inetutils-inetd; then
	if [ -d /run/systemd/system ]; then
		systemctl disable --now inetutils-inetd.service >/dev/null 2>&1 || true
	else
		systemctl disable inetutils-inetd.service >/dev/null 2>&1 || true
	fi
	echo "citronics-initramfs: stopped the telnet server inetutils-inetd; remove it with: apt autoremove"
fi

# The init mounts /boot from a device-mapper partition (kpartx) that udev
# never marks ready, so a boot-time fsck of /boot (fstab pass 2, as images
# before 2026-11 set it) made systemd wait 90 s for the device at every boot.
if [ "$1" = configure ] && [ -f /etc/fstab ] &&
   findmnt -no SOURCE /boot 2>/dev/null | grep -Eq '^/dev/(mapper/)?mmcblk[0-9]+p[0-9]+p[0-9]+$'; then
	sed -i -E 's|^(UUID=[0-9a-fA-F-]+[[:space:]]+/boot[[:space:]]+ext2[[:space:]]+defaults[[:space:]]+0[[:space:]]+)2[[:space:]]*$|\10|' /etc/fstab
fi

# Images before 2026-11 asked for a boot menu in extlinux.conf, which lk2nd
# ignores and which made U-Boot wait for typed input: drop exactly those
# lines, so both boot the default label.
CONF=/boot/extlinux/extlinux.conf
if [ "$1" = configure ] && [ -f "$CONF" ] &&
   grep -qxE 'timeout 1|menu title boot prev kernel' "$CONF"; then
	sed -i -E '/^(timeout 1|menu title boot prev kernel)$/d' "$CONF"
fi

# An upgrade changes the init scripts and hooks, which only reach the boot
# partition through a new initramfs. update-initramfs -u has nothing to
# update (the hook renames initrd.img-* to /boot/initramfs.gz), so the
# initramfs of the kernel on the boot partition is created again; the
# post-update hook validates it before it replaces /boot/initramfs.gz.
if [ "$1" = configure ] && [ -n "$2" ] && [ -s "$STATE" ] && command -v update-initramfs >/dev/null; then
	KVER=$(cat "$STATE")
	if [ -d "/lib/modules/$KVER" ]; then
		update-initramfs -c -k "$KVER" || echo "citronics-initramfs: could not rebuild the initramfs of $KVER" >&2
	fi
fi
exit 0
